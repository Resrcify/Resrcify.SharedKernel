<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.UnitOfWork</PackageId>
    <Title>Resrcify.SharedKernel.UnitOfWork</Title>
    <Description>Implements a unit of work pattern, including interceptors using EntityFrameworkCore.</Description>
    <Summary>Implements a unit of work pattern, includin interceptors using EntityFrameworkCore.</Summary>
    <PackageTags>$(PackageTags);unit-of-work;outbox;entity-framework-core;quartz;domain-events</PackageTags>
  </PropertyGroup>

  <!-- Real dependencies: EF Core (DbContext, interceptors, the model builder) and Quartz (IJob, the job helpers) are in
       this package's API, so a service gets them from this reference, at least at the versions this package was built
       against. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Quartz" />
    <!-- The outbox lanes are a hosted service that logs. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.UnitTests" />
    <!-- WithOutbox() registers the outbox's default claim (OutboxDefaultClaim). -->
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.Postgres" />
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.Postgres.UnitTests" />
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resrcify.SharedKernel.Abstractions\Resrcify.SharedKernel.Abstractions.csproj" />
  </ItemGroup>

</Project>
