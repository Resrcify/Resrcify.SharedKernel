<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.UnitOfWork.Web</PackageId>
    <Title>Resrcify.SharedKernel.UnitOfWork.Web</Title>
    <Description>Admin endpoints for the outbox: what waits and what gave up, per event type and lane, each message's content and error, and retrying messages that gave up.</Description>
    <Summary>Outbox admin endpoints: summary, given-up messages, retry.</Summary>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Private, like every SharedKernel package's dependencies: the service references EF Core itself. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.UnitOfWork\Resrcify.SharedKernel.UnitOfWork.csproj" />
  </ItemGroup>
</Project>
