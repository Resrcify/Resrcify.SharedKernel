<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.Repository</PackageId>
    <Title>Resrcify.SharedKernel.Repository</Title>
    <Description>Implements a generic repository pattern using EntityFrameworkCore.</Description>
    <Summary>Implements a generic repository pattern using EntityFrameworkCore.</Summary>
    <PackageTags>$(PackageTags);repository;entity-framework-core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.Abstractions\Resrcify.SharedKernel.Abstractions.csproj" />
    <ProjectReference Include="..\Resrcify.SharedKernel.Results\Resrcify.SharedKernel.Results.csproj" />
    <ProjectReference Include="..\Resrcify.SharedKernel.DomainDrivenDesign\Resrcify.SharedKernel.DomainDrivenDesign.csproj" />
  </ItemGroup>
  <!-- Real dependencies: the repositories are built on EF Core's DbContext (Persistence only). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
