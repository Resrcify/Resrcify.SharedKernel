<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.Mediator</PackageId>
    <Title>Resrcify.SharedKernel.Mediator</Title>
    <Description>In-process mediator: request/notification/stream dispatching with pipeline behaviors.</Description>
    <Summary>In-process mediator: request/notification/stream dispatching with pipeline behaviors.</Summary>
    <PackageTags>$(PackageTags);mediator;pipeline-behaviors;commands;queries</PackageTags>
  </PropertyGroup>

  <!-- Real dependencies: ValidationPipelineBehavior takes FluentValidation's IValidator<T>, the assembly scan registers
       the validators (FluentValidation.DependencyInjectionExtensions), the behaviors take ILogger<T>. Application
       references this package and holds the validators, so it gets FluentValidation at least at the version this
       package was built against; Domain never references this package. -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.Mediator.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.Abstractions\Resrcify.SharedKernel.Abstractions.csproj" />
    <ProjectReference Include="..\Resrcify.SharedKernel.Results\Resrcify.SharedKernel.Results.csproj" />
  </ItemGroup>
</Project>
