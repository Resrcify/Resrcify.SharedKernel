<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.Web</PackageId>
    <Title>Resrcify.SharedKernel.Web</Title>
    <Description>ASP.NET Core helpers around the result pattern: problem details for failures and unhandled exceptions, reading responses back as results, health endpoints, an ErrorType-keyed HTTP resilience preset and the shared JWT bearer setup.</Description>
    <Summary>ASP.NET Core helpers around the result pattern: problem details, health endpoints, HTTP resilience, JWT bearer.</Summary>
    <PackageTags>$(PackageTags);aspnetcore;minimal-api;problem-details;jwt;http-client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Real dependencies: AddResultResilience returns Microsoft.Extensions.Http.Resilience's
       IHttpResiliencePipelineBuilder, AddResrcifyJwtBearer takes JwtBearerOptions, so a service gets them from this
       reference, at least at the versions this package was built against. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.Abstractions\Resrcify.SharedKernel.Abstractions.csproj" />
    <ProjectReference Include="..\Resrcify.SharedKernel.Results\Resrcify.SharedKernel.Results.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.Web.UnitTests" />
  </ItemGroup>
</Project>
