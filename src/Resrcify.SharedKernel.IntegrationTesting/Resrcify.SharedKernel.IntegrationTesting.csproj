<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.IntegrationTesting</PackageId>
    <Title>Resrcify.SharedKernel.IntegrationTesting</Title>
    <Description>Composable integration-test fixtures (Testcontainers Postgres / RabbitMQ + WebApplicationFactory) for downstream services.</Description>
    <Summary>Composable integration-test fixtures (Testcontainers Postgres / RabbitMQ + WebApplicationFactory) for downstream services.</Summary>
    <IsTestProject>false</IsTestProject>
    <PackageTags>$(PackageTags);integration-tests;testcontainers;postgresql;rabbitmq;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <!-- ServiceHostFixture.Logs: Microsoft's FakeLogCollector, fed by the logging abstraction and by Serilog. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Serilog" />
    <!-- ServiceHostFixture.RenderedLogs: the formatter production's console uses. -->
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceHostFixture's message bus test harness switch, and RabbitMqContainerFixture.Connection. -->
    <ProjectReference Include="..\Resrcify.SharedKernel.MessageBus.Testing\Resrcify.SharedKernel.MessageBus.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.IntegrationTesting.UnitTests" />
  </ItemGroup>
</Project>
