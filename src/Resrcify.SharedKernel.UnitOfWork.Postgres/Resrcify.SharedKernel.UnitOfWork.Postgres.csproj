<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.UnitOfWork.Postgres</PackageId>
    <Title>Resrcify.SharedKernel.UnitOfWork.Postgres</Title>
    <Description>PostgreSQL wiring for the unit of work: a DbContext from the services' Database section with the SharedKernel interceptors, retries, an xmin concurrency token, a design-time factory for dotnet ef, and an outbox woken by NOTIFY.</Description>
    <Summary>PostgreSQL DbContext setup, design-time factory, xmin row versions and an outbox woken by NOTIFY.</Summary>
    <PackageTags>$(PackageTags);unit-of-work;outbox;postgresql;npgsql;entity-framework-core</PackageTags>
  </PropertyGroup>

  <!-- Real dependencies: Npgsql's EF provider and EF Core are in this package's API (the DbContext setup, the design-time
       factory), so a service gets them from this reference, at least at the versions this package was built against. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- The configuration providers and options binding the DbContext setup and the design-time factory read with
         (a Persistence project gets them from here for dotnet ef). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The wake-up listener is a hosted service that logs. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- AddPostgres<TContext> extends IHealthChecksBuilder. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.Postgres.UnitTests" />
    <InternalsVisibleTo Include="Resrcify.SharedKernel.UnitOfWork.Postgres.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.UnitOfWork\Resrcify.SharedKernel.UnitOfWork.csproj" />
  </ItemGroup>
</Project>
