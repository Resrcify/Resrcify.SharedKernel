<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.Caching</PackageId>
    <Title>Resrcify.SharedKernel.Caching</Title>
    <Description>Adds interfaces and implements different caching options using the IDistributedCache interfaces.</Description>
    <Summary>Adds interfaces and implements different caching options using the IDistributedCache interfaces.</Summary>
    <PackageTags>$(PackageTags);caching;distributed-cache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.Abstractions\Resrcify.SharedKernel.Abstractions.csproj" />
  </ItemGroup>

  <!-- Real dependencies: IDistributedCache (DistributedCachingService) and MemoryDistributedCacheOptions
       (AddDistributedCaching) are in this package's API. Inner layers never reference this package (they use
       ICachingService from Abstractions), so nothing reaches Domain or Application through it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <!-- AddDistributedCaching's in-memory cache. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>
</Project>
