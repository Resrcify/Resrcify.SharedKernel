<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>Resrcify.SharedKernel.Observability</PackageId>
    <Title>Resrcify.SharedKernel.Observability</Title>
    <Description>One-call service telemetry: OpenTelemetry tracing and metrics (ASP.NET Core, HttpClient, runtime, every SharedKernel source, Quartz), the Prometheus scrape endpoint, OTLP trace export when configured, and Serilog with trace-correlated logs.</Description>
    <Summary>One-call service telemetry: OpenTelemetry, Prometheus, OTLP and Serilog wired the same way in every service.</Summary>
    <PackageTags>$(PackageTags);opentelemetry;prometheus;otlp;serilog;tracing;metrics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Real dependencies: their types are in this package's API (TracerProviderBuilder, MeterProviderBuilder, Serilog's
       LoggerConfiguration and RequestLoggingOptions), so a service gets them from this reference, at least at the
       versions this package was built against (NuGet refuses a lower one at restore). -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <!-- UseServiceRequestLogging (Serilog's request logging): its RequestLoggingOptions is in the signature. -->
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <!-- Only ever published as a prerelease, which a stable package can't depend on (NU5104): the service references it
       itself (every service does already). AddServiceTelemetry says so at start-up when it is missing. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The logged-once convention (LoggedExceptions). Results references nothing but the BCL. -->
  <ItemGroup>
    <ProjectReference Include="..\Resrcify.SharedKernel.Results\Resrcify.SharedKernel.Results.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resrcify.SharedKernel.Observability.UnitTests" />
  </ItemGroup>
</Project>
