<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A tiny service for ServiceHostFixture's own tests: it reads its settings while registering, as the services do. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- What a service references itself next to Observability: a prerelease, so no dependency of the package. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
  </ItemGroup>

  <!-- Turned on by settings, for the fixture's log capture and message bus tests. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Resrcify.SharedKernel.MessageBus\Resrcify.SharedKernel.MessageBus.csproj" />
    <ProjectReference Include="..\..\src\Resrcify.SharedKernel.Observability\Resrcify.SharedKernel.Observability.csproj" />
  </ItemGroup>
</Project>
